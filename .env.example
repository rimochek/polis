APP_PORT=18080
APP_ORIGIN=https://example.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
AI_PROVIDER=vertex
GOOGLE_API_KEY=
# Or a short-lived OAuth token, never both:
GOOGLE_ACCESS_TOKEN=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_MODEL=gemini-3.8-flash
GOOGLE_VERTEX_EXPRESS=false
DATABASE_URL=postgresql://polis:polis-dev-password@127.0.0.1:5432/polis?schema=public
AUTH_SECRET=replace-with-a-random-32-byte-secret
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_BUCKET=polis-documents
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=polis-minio
STORAGE_SECRET_ACCESS_KEY=polis-minio-password
